{
  "name": "@proxidize/mcp",
  "version": "0.1.0",
  "description": "Proxidize MCP server for managing mobile and residential proxies",
  "type": "module",
  "bin": {
    "proxidize-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "postinstall": "npx playwright install chromium",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "proxidize",
    "proxy",
    "mobile-proxy"
  ],
  "author": "Proxidize",
  "license": "MIT",
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toolprint/mcp-logger": "^0.0.7",
    "axios": "^1.16.1",
    "https-proxy-agent": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "npm:rebrowser-playwright@^1.60.0",
    "retry-axios": "^4.0.3",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.8.0",
    "@types/turndown": "^5.0.6",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  }
}
